{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Nombre de instancia de Data Factory",
            "defaultValue": "adf-finbank-dev-eus-2nctv"
        },
        "ls_akv_finbank_dev_properties_typeProperties_baseUrl": {
            "type": "string",
            "defaultValue": "https://kv-finbank-dev-2nctv.vault.azure.net/"
        },
        "ls_azuresql_finbank_dev_properties_typeProperties_server": {
            "type": "string",
            "defaultValue": "sql-finbank-dev-cus-2nctv.database.windows.net"
        },
        "ls_azuresql_finbank_dev_properties_typeProperties_database": {
            "type": "string",
            "defaultValue": "sqldb-finbank-dev"
        },
        "ls_azuresql_finbank_dev_properties_typeProperties_userName": {
            "type": "string",
            "defaultValue": "finbankadmin"
        },
        "ls_adls_finbank_dev_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://dlsfinbankdeveus2nctv.dfs.core.windows.net/"
        },
        "containerUri": {
            "type": "string",
            "metadata": "URI de la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas."
        },
        "containerSasToken": {
            "type": "string",
            "metadata": "Token de SAS para la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "adf-finbank-dev-eus-2nctv_ArmTemplate_0",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    },
                    "ls_akv_finbank_dev_properties_typeProperties_baseUrl": {
                        "value": "[parameters('ls_akv_finbank_dev_properties_typeProperties_baseUrl')]"
                    },
                    "ls_adls_finbank_dev_properties_typeProperties_url": {
                        "value": "[parameters('ls_adls_finbank_dev_properties_typeProperties_url')]"
                    },
                    "ls_azuresql_finbank_dev_properties_typeProperties_server": {
                        "value": "[parameters('ls_azuresql_finbank_dev_properties_typeProperties_server')]"
                    },
                    "ls_azuresql_finbank_dev_properties_typeProperties_database": {
                        "value": "[parameters('ls_azuresql_finbank_dev_properties_typeProperties_database')]"
                    },
                    "ls_azuresql_finbank_dev_properties_typeProperties_userName": {
                        "value": "[parameters('ls_azuresql_finbank_dev_properties_typeProperties_userName')]"
                    }
                }
            },
            "dependsOn": []
        }
    ]
}