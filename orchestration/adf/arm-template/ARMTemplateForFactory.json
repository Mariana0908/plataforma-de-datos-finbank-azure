                        "defaultValue": "TB_CLIENTES_CORE/year=2026/month=08/day=25"
                    },
                    "p_file_name": {
                        "type": "string",
                        "defaultValue": "TB_CLIENTES_CORE_test.parquet"
                    }
                },
                "annotations": [],
                "type": "Parquet",
                "typeProperties": {
                    "location": {
                        "type": "AzureBlobFSLocation",
                        "fileName": {
                            "value": "@dataset().p_file_name",
                            "type": "Expression"
                        },
                        "folderPath": {
                            "value": "@dataset().p_folder_path",
                            "type": "Expression"
                        },
                        "fileSystem": {
                            "value": "bronze",
