                "schema": [],
                "typeProperties": {
                    "schema": {
                        "value": "@dataset().p_schema",
                        "type": "Expression"
                    },
                    "table": {
                        "value": "@dataset().p_table",
                        "type": "Expression"
                    }
                }
            },
            "dependsOn": [
