            "type": "Microsoft.DataFactory/factories/triggers",
            "apiVersion": "2018-06-01",
            "properties": {
                "description": "Ejecución diaria del pipeline end-to-end de FinBank. Se mantiene detenido en desarrollo para controlar costos.",
                "annotations": [],
                "runtimeState": "Stopped",
                "pipelines": [
                    {
                        "pipelineReference": {
                            "referenceName": "pl_finbank_end_to_end",
                            "type": "PipelineReference"
                        },
                        "parameters": {
                            "p_catalog": "[parameters('tr_finbank_daily_dev_properties_pl_finbank_end_to_end_parameters_p_catalog')]",
