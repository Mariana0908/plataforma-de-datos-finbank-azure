# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/

# ============================================================
# Generated data
# ============================================================
data-generation/output/
data-generation/generated/
data-generation/data/

# Preserve directory placeholders if required
!data-generation/output/.gitkeep
!data-generation/generated/.gitkeep
!data-generation/data/.gitkeep

# ============================================================
# Terraform
# ============================================================
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Local or potentially sensitive variable files
terraform.tfvars
*.auto.tfvars
*.secret.tfvars

# Allow safe templates
!*.tfvars.example
!*.auto.tfvars.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Do not ignore .terraform.lock.hcl
# This lock file should be versioned for reproducibility.

# ============================================================
# Secrets and credentials
# ============================================================
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt

# Azure and Databricks local configuration
.azure/
.databricks/
databricks.cfg

# ============================================================
# Logs and temporary files
# ============================================================
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# ============================================================
# Visual Studio Code and IDEs
# ============================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# ============================================================
# Operating system files
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Jupyter
# ============================================================
.ipynb_checkpoints/